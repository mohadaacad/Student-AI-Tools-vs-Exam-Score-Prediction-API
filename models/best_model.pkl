import os
import joblib
import pandas as pd
from sklearn.metrics import r2_score

# Assuming trained_models is a dictionary of your trained models:
# e.g., trained_models = {"Linear Regression": lr_model, "Random Forest": rf_model, ...}
# And X_test, y_test are your evaluation datasets.

def select_and_save_best_model(trained_models: dict, X_test: pd.DataFrame, y_test: pd.Series) -> str:
    """Select the best-performing model based on R² score, save it using joblib, 
    and demonstrate loading it back.
    """
    best_model_name = None
    best_model = None
    highest_r2 = -float("inf")

    # 1. Automatically evaluate and select the model with the highest R² score
    for name, model in trained_models.items():
        y_pred = model.predict(X_test)
        score = r2_score(y_test, y_pred)
        print(f"Model: {name} | R² Score: {score:.4f}")
        
        if score > highest_r2:
            highest_r2 = score
            best_model_name = name
            best_model = model

    print(f"\nBest Model Selected: {best_model_name} with R²: {highest_r2:.4f}")

    # 2 & 3. Ensure the models directory exists and save the best model
    output_dir = "models"
    os.makedirs(output_dir, exist_ok=True)
    
    model_path = os.path.join(output_dir, "best_model.pkl")
    joblib.dump(best_model, model_path)
    
    # 4. Print success message
    print(f"Success! Best model saved to: {model_path}")

    # 5. Demonstrate how to load the saved model again using Joblib
    print("\n--- Demonstrating Model Loading ---")
    loaded_model = joblib.load(model_path)
    print(f"Successfully loaded model from {model_path}")
    print(f"Loaded model type: {type(loaded_model)}")

    return model_path
